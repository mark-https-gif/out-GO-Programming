import "disk"

test_file = "C:/Users/7349~1/AppData/Local/Temp/outtest/disk_handle_test.bin"

// open handle for write
h = disk::open(test_file, "write")
print("handle:", h)

// write two 512-byte aligned chunks
ok = disk::write(h, "AAAAAAAAAAAAAAAA")   // 16 bytes
print("write1 ok:", ok)

ok = disk::seek(h, 0)
print("seek ok:", ok)

// read back 16 bytes
data = disk::read(h, 16)
print("read back:", data)

ok = disk::flush(h)
print("flush ok:", ok)

ok = disk::close(h)
print("close ok:", ok)

// reopen readonly
h2 = disk::open(test_file, "read")
print("handle2:", h2)
data2 = disk::read(h2, 16)
print("read2:", data2)
disk::close(h2)